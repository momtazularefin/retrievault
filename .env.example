# retrievault - Environment Configuration
# DO NOT COMMIT actual secrets in .env!

# LLM Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RETRIEVAULT_SYNTHESIS_MODEL=claude-sonnet-4-6

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
# Leave empty for local Docker Compose Qdrant; set only for secured remote Qdrant.
QDRANT_API_KEY=

# Corpus Configuration
CORPUS_REPO=fastapi/fastapi
CORPUS_TAG=0.136.3

# Retrieval Parameters (defaults)
PREFETCH_LIMIT=50
TOP_N_FUSION=30
TOP_K_RERANK=6
RERANK_MODEL_DIR=models/bge-reranker-onnx

# Hardware Acceleration: "cpu", "gpu", or "npu"
# Selects ONNX Runtime providers for fastembed and the ONNX reranker.
# If gpu or npu is chosen and the drivers/execution runtimes are missing, the system will raise an error.
EXECUTION_DEVICE=cpu

# Eval Configuration
# For a full evaluation run, set EVAL_GOOD_COUNT=45 (total good questions in dataset)
# and EVAL_REFUSAL_COUNT=5 (total trick questions).
# Defaults below run a fast, low-cost smoke test of the pipeline.
EVAL_GOOD_COUNT=3
EVAL_REFUSAL_COUNT=2
# Platform options: "claude" or "openai"; there is no automatic provider fallback.
EVAL_JUDGE_PROVIDER=claude
# Choose model matching your provider, e.g., "claude-haiku-4-5-20251001" or "gpt-4o-mini"
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001

# Caching Configuration
# Enables Layer 1 caching of backend responses to avoid API cost/time for unchanged queries
# Should be set to False (disabled) so that code changes are evaluated fresh
EVAL_USE_RESPONSE_CACHE=False

# Enables Layer 2 SQLite caching for Ragas LLM Judge calls.
# Set to False (disabled) by default to ensure grading prompts run fresh.
EVAL_USE_JUDGE_CACHE=False
