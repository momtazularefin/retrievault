# RetrieVault - environment configuration
# Copy to .env and fill in the keys. Never commit .env.

# --- Synthesis -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
RETRIEVAULT_SYNTHESIS_MODEL=claude-sonnet-4-6
SYNTHESIS_MAX_TOKENS=2048
# Published per-million-token prices, used for the cost estimate in query metadata.
SYNTHESIS_INPUT_USD_PER_MTOK=3.0
SYNTHESIS_OUTPUT_USD_PER_MTOK=15.0

# --- Qdrant ----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave empty for the local Docker Compose Qdrant; set only for a secured remote instance.
QDRANT_API_KEY=
QDRANT_COLLECTION=retrievault_fastapi

# --- Corpus ----------------------------------------------------------------------------
CORPUS_REPO=fastapi/fastapi
CORPUS_TAG=0.136.3

# --- Retrieval -------------------------------------------------------------------------
PREFETCH_LIMIT=50
TOP_N_FUSION=12
TOP_K_RERANK=6
# Set to false to send the fused top-k straight to the model, skipping the cross-encoder.
RERANK_ENABLED=true

# --- Local models ----------------------------------------------------------------------
EMBED_MODEL=BAAI/bge-base-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=BAAI/bge-reranker-base
# Where fastembed keeps downloaded ONNX models. Its default is the system temp directory,
# which is cleared periodically; set a stable path to avoid re-downloading ~1.2 GB.
# FASTEMBED_CACHE_PATH=

# Hardware acceleration for the ONNX models: "none", "gpu", or "npu".
#   none = CPU only (the default, and what the published numbers were measured on)
#   gpu  = CUDA, ROCm, or DirectML, whichever ONNX Runtime has
#   npu  = Vitis AI (AMD Ryzen AI). DirectML is a GPU path and is not accepted here.
# A requested accelerator that is missing raises rather than falling back to the CPU.
ACCELERATION=none

# --- API -------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Evaluation ------------------------------------------------------------------------
# Number of dataset items to use; the full set is 45 answerable + 5 refusal.
EVAL_GOOD_COUNT=45
EVAL_REFUSAL_COUNT=5
# Judge provider and model; the evaluation plan fixes Claude Haiku 4.5 for reproducibility.
EVAL_JUDGE_PROVIDER=claude
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001
# Parallel judge calls (the pipeline itself is run one query at a time, so that the reported
# latencies are single-request latencies).
EVAL_MAX_WORKERS=8
# Only needed when EVAL_JUDGE_PROVIDER=openai.
OPENAI_API_KEY=

# --- Frontend --------------------------------------------------------------------------
# Set in frontend/.env.local, not here.
# NEXT_PUBLIC_API_URL=http://localhost:8000
